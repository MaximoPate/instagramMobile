{
  "expo": {
    "name": "Instagram",
    "slug": "tp9-efsi-patejim_feldman",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "instagramclon",
    "icon": "./assets/imagenes/icono.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.anonymous.tp9efsipatejim_feldman",
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "adaptiveIcon": {
        "backgroundImage": "./assets/imagenes/android-icono-fondo.png",
        "foregroundImage": "./assets/imagenes/android-icono-frente.png",
        "monochromeImage": "./assets/imagenes/android-icono-monocromo.png"
      }
    },
    "web": {
      "output": "single",
      "favicon": "./assets/imagenes/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/imagenes/splash.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF",
          "dark": {
            "image": "./assets/imagenes/splash.png",
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "reactCompiler": true
    }
  }
}
